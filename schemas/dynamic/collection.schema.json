{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "type",
    "id",
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "type": {
      "const": "dynamic"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    }
  }
}
